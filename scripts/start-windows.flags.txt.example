# Android Test Flow Editor startup flags (KEY=VALUE)
# Lines starting with # are comments.
# Do not use spaces around '='.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# If empty, start-windows will use http://BACKEND_HOST:BACKEND_PORT/api
FRONTEND_API_BASE=

# 1 = open browser after startup, 0 = do not open
OPEN_BROWSER=1

# 1 = always reinstall backend dependencies
FORCE_INSTALL=0

# 1 = rebuild backend .venv before startup
REBUILD_VENV=0

# ---------------------------------------------------------------------------
# Login authentication (optional)
# Set ENABLE_LOGIN=1 to require username + password before using the app.
# Leave ENABLE_LOGIN=0 (default) for lab / local environments with no login.
# ---------------------------------------------------------------------------

# 1 = enable login screen, 0 = disable (default)
ENABLE_LOGIN=0

# Required only when ENABLE_LOGIN=1
# LOGIN_USERNAME=admin
# LOGIN_PASSWORD=yourpassword
